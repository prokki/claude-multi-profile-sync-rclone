# Profile "private" - copy this file to private.conf (without .example) in
# this same directory and adjust the values below. *.conf is gitignored,
# *.conf.example is checked in.
REMOTE="myprivate_remote:claude-sync"
PROJECTS="$HOME/claude-private"
CFG="$HOME/.claude-private"
# Optional: also sync $CFG/skills (copy --update, nothing is deleted; skills/synced/
# and *.bak-* are excluded). Leave it out (or empty) to skip skills for this profile.
# SYNC_SKILLS=1
